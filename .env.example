# Incident Response Agent - environment configuration
# All values are optional: the API runs with zero configuration using an
# in-memory demo store and a deterministic (rule-based) diagnosis fallback.

# ---------------------------------------------------------------- persistence
# Leave empty to use the seeded in-memory store (great for demos/tests).
SUPABASE_URL=
SUPABASE_KEY=

# ---------------------------------------------------------------- AI provider
# Leave empty to use the deterministic fallback diagnosis (labelled in the UI).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
DIAGNOSIS_MAX_TOKENS=1024

# ---------------------------------------------------------------- correlation
CORRELATION_WINDOW_MINUTES=60
TEMPORAL_DECAY_HALF_LIFE_MINUTES=20
MIN_CORRELATION_SCORE=45
